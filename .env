# Pinned tool versions for the Petclinic environment.
# Docker Compose reads this file automatically. Change a version here, nowhere else,
# and record the change in docs/environment.md.
#
# Checked against Docker Hub / npm on 2026-11-11.

# Backend build + runtime (Eclipse Temurin, Ubuntu Noble). Java 21 matches CI (ci.yml).
TEMURIN_VERSION=21.0.13_9

# Frontend build, Playwright runner, Newman runner. Node 24 matches .nvmrc.
NODE_VERSION=24.22.2

# Web server for the built Angular app.
NGINX_VERSION=1.31.8

# OWASP ZAP baseline scanner (docker.io/zaproxy/zap-stable).
ZAP_VERSION=2.17.0

# Newman API test runner and its HTML reporter.
NEWMAN_VERSION=6.2.3
NEWMAN_HTMLEXTRA_VERSION=1.23.1

# Playwright is NOT pinned here: its version comes from spring-petclinic-angular/package-lock.json
# (currently 1.64.1), and the runner image installs the browser that matches it.

# Turn API basic-auth security on (true) or off (false, the default).
PETCLINIC_SECURITY_ENABLE=false
